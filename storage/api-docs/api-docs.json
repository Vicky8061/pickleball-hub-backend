{
    "openapi": "3.0.0",
    "info": {
        "title": "Pickleball Hub API",
        "description": "API documentation for Pickleball Hub",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/api/admin/owner-applications": {
            "get": {
                "tags": [
                    "Admin - Owner Applications"
                ],
                "summary": "Get owner applications",
                "description": "Returns a paginated list of owner applications for admin users. Supports searching, status filtering, sorting, and pagination.",
                "operationId": "57751656a4a97a8785055207bfda6103",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by applicant name, email, or business name.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Vicky"
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter applications by status.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pending",
                                "approved",
                                "rejected"
                            ]
                        },
                        "example": "pending"
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort applications by creation date.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "latest",
                            "enum": [
                                "latest",
                                "oldest"
                            ]
                        },
                        "example": "latest"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Owner applications fetched successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Unauthorized. Admin access required."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/admin/owner-applications/{ownerApplication}": {
            "get": {
                "tags": [
                    "Admin - Owner Applications"
                ],
                "summary": "Get owner application details",
                "description": "Returns the details of a specific owner application for admin review.",
                "operationId": "a43f2b482cb86ad77606b1214ef5f83f",
                "parameters": [
                    {
                        "name": "ownerApplication",
                        "in": "path",
                        "description": "Owner application ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Owner application fetched successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Unauthorized. Admin access required."
                    },
                    "404": {
                        "description": "Owner application not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/admin/owner-applications/{ownerApplication}/approve": {
            "patch": {
                "tags": [
                    "Admin - Owner Applications"
                ],
                "summary": "Approve owner application",
                "description": "Approves an owner application and promotes the associated user to owner status.",
                "operationId": "e8d81b4f10dccb40d5f6ba7824126510",
                "parameters": [
                    {
                        "name": "ownerApplication",
                        "in": "path",
                        "description": "Owner application ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "admin_note": {
                                        "type": "string",
                                        "example": "Documents verified. Owner application approved.",
                                        "nullable": true,
                                        "maxLength": 500
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Owner application approved successfully"
                    },
                    "400": {
                        "description": "Application is already approved or has been rejected"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Unauthorized. Admin access required."
                    },
                    "404": {
                        "description": "Owner application not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/admin/owner-applications/{ownerApplication}/reject": {
            "patch": {
                "tags": [
                    "Admin - Owner Applications"
                ],
                "summary": "Reject owner application",
                "description": "Rejects an owner application. An admin rejection reason is required.",
                "operationId": "b4a1c69fae7b744da8dad8dc4c1fad5b",
                "parameters": [
                    {
                        "name": "ownerApplication",
                        "in": "path",
                        "description": "Owner application ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "admin_note"
                                ],
                                "properties": {
                                    "admin_note": {
                                        "type": "string",
                                        "example": "Verification document is not valid.",
                                        "maxLength": 500
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Owner application rejected successfully"
                    },
                    "400": {
                        "description": "Application is already rejected, already approved, or can no longer be rejected"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Unauthorized. Admin access required."
                    },
                    "404": {
                        "description": "Owner application not found"
                    },
                    "422": {
                        "description": "Validation error. Rejection reason is required."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new user",
                "description": "Register a normal user account.",
                "operationId": "8e4e3cb7b46126f4696379d3c7eeb4ad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Vicky"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "vicky@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Registration successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Registration successful."
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "name": {
                                                            "type": "string",
                                                            "example": "Vicky"
                                                        },
                                                        "email": {
                                                            "type": "string",
                                                            "example": "vicky@gmail.com"
                                                        },
                                                        "role": {
                                                            "type": "string",
                                                            "example": "user"
                                                        },
                                                        "status": {
                                                            "type": "string",
                                                            "example": "active"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "token": {
                                                    "type": "string",
                                                    "example": "1|abcdefghijklmnopqrstuvwxyz"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Password must be at least 8 characters"
                                        },
                                        "errors": {
                                            "properties": {
                                                "password": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "Password must be at least 8 characters"
                                                    ]
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User login",
                "description": "Login for user, owner, and admin accounts.",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    },
                    "401": {
                        "description": "Invalid email or password"
                    },
                    "403": {
                        "description": "Account is pending or blocked"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout user",
                "description": "Logout the currently authenticated user and revoke the current Sanctum access token.",
                "operationId": "ad65cbbd4e9f201619eae184a5961a98",
                "responses": {
                    "200": {
                        "description": "Logout successful"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/profile": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get authenticated user profile",
                "description": "Returns the profile information of the currently authenticated user.",
                "operationId": "94a5f4c5f5e5755cf43698cf9bc49e9d",
                "responses": {
                    "200": {
                        "description": "Profile fetched successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/owner/apply": {
            "post": {
                "tags": [
                    "Owner Application"
                ],
                "summary": "Apply to become an owner",
                "description": "Allows an authenticated normal user to submit an application to become an owner. A verification document is required.",
                "operationId": "a91ac2c6110b5d3d09f0450c25edfcf9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "business_name",
                                    "phone",
                                    "address",
                                    "city",
                                    "state",
                                    "pincode",
                                    "document"
                                ],
                                "properties": {
                                    "business_name": {
                                        "type": "string",
                                        "example": "Vicky Pickleball Club"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "9876543210"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "123 Main Road, Adajan"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Surat"
                                    },
                                    "state": {
                                        "type": "string",
                                        "example": "Gujarat"
                                    },
                                    "pincode": {
                                        "type": "string",
                                        "example": "395009"
                                    },
                                    "experience": {
                                        "type": "string",
                                        "example": "5 years of experience in sports management.",
                                        "nullable": true
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "I want to start and manage a professional pickleball facility.",
                                        "nullable": true
                                    },
                                    "document": {
                                        "description": "Verification document. Allowed formats: PDF, JPG, JPEG, PNG. Maximum size: 5 MB.",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Owner application submitted successfully"
                    },
                    "400": {
                        "description": "User already has a pending owner application"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Only normal users can apply"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/owner/application": {
            "get": {
                "tags": [
                    "Owner Application"
                ],
                "summary": "Get my owner application",
                "description": "Returns the authenticated user's latest owner application and its current status.",
                "operationId": "46c7c3761673381bbbb511e0797bee77",
                "responses": {
                    "200": {
                        "description": "Owner application fetched successfully or no application has been submitted yet"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Only normal users can access owner applications"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "Sanctum Token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Admin - Owner Applications",
            "description": "Admin - Owner Applications"
        },
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Owner Application",
            "description": "Owner Application"
        }
    ]
}
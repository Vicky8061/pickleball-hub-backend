                    },
                    "404": {
                        "description": "Booking not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/courts": {
            "get": {
                "tags": [
                    "Courts"
                ],
                "summary": "Get courts",
                "description": "Returns a paginated list of courts with search, filtering, price range, and sorting options.",
                "operationId": "c022902eaf90a4be03fd53295dab53d2",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search courts by court name.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Pickleball Arena"
                    },
                    {
                        "name": "court_type",
                        "in": "query",
                        "description": "Filter courts by court type.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "indoor"
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Filter courts by status. This filter is intended for admin users.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "active",
                                "inactive"
                            ]
                        },
                        "example": "active"
                    },
                    {
                        "name": "city",
                        "in": "query",
                        "description": "Filter courts by city/address.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "Surat"
                    },
                    {
                        "name": "price_min",
                        "in": "query",
                        "description": "Minimum price per hour.",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float",
                            "minimum": 0
                        },
                        "example": 200
                    },
                    {
                        "name": "price_max",
                        "in": "query",
                        "description": "Maximum price per hour.",
                        "required": false,
                        "schema": {
                            "type": "number",
                            "format": "float",
                            "minimum": 0
                        },
                        "example": 1000
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort courts by price or latest.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "latest",
                            "enum": [
                                "price_low",
                                "price_high",
                                "latest"
                            ]
                        },
                        "example": "price_low"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Courts fetched successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },

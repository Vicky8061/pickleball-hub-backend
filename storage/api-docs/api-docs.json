                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Bookings"
                ],
                "summary": "Cancel a booking",
                "description": "Cancels a booking belonging to the authenticated user. Completed bookings cannot be cancelled.",
                "operationId": "dd0cd74ecc75a87121ba3e03ee226677",
                "parameters": [
                    {
                        "name": "booking",
                        "in": "path",
                        "description": "Booking ID.",
                        "required": true,
